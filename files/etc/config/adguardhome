#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/AdGuardHome
CONF=/etc/adguardhome/adguardhome.yaml
WORK=/etc/adguardhome/work

start_service() {
    mkdir -p "$WORK/data" "$WORK/filters" "$WORK/stats" "$WORK/sessions"
    chmod -R 700 "$WORK" 2>/dev/null || true

    procd_open_instance "adguardhome"
    procd_set_param command "$PROG" -c "$CONF" -w "$WORK"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    killall -9 AdGuardHome 2>/dev/null || true
}
